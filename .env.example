# Copy this file to .env and fill in real values before running docker-compose.

# --- General ---
APP_NAME=Sham ERP
ENVIRONMENT=development
COMPANY_NAME=Your Company Name
DEFAULT_CURRENCY=KWD
DEFAULT_LOCALE=ar

# --- Postgres ---
POSTGRES_USER=sham_erp
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sham_erp
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://sham_erp:changeme@postgres:5432/sham_erp

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Security ---
SECRET_KEY=changeme-generate-a-long-random-value
